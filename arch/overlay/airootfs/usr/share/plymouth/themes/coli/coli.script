# COLI Linux: анимация загрузки.
# Знак делает один плавный оборот и останавливается; когда он прошёл около 80% оборота,
# разгорается вихрь из закрученных полосок света (расходится к краям); потом попеременно светятся то белые
# лезвия (синие тусклые), то синие (белые тусклые).

Window.SetBackgroundTopColor(0.0196, 0.0275, 0.0510);
Window.SetBackgroundBottomColor(0.0196, 0.0275, 0.0510);

global.sw = Window.GetWidth();
global.sh = Window.GetHeight();
global.cx = global.sw / 2;
global.cy = global.sh * 0.46;
global.D = global.sh * 0.36;               # диаметр знака на экране
if (global.D > global.sw * 0.6) global.D = global.sw * 0.6;

# время сцен, секунды
global.T0 = 0.6;                            # начало оборота
global.T1 = 2.6;                            # конец оборота
global.TB = 1.95;                           # начало вихря: знак прошёл ~80% оборота
global.TI = 3.4;                            # начало поочерёдного свечения
global.P = 2.4;                             # период смены свечения
global.PI2 = 6.2831853;

fun load_scaled(name, w) {
  local.img = Image(name);
  local.h = Math.Int(w * img.GetHeight() / img.GetWidth());
  return img.Scale(Math.Int(w), h);
}

fun place(sprite, img) {
  sprite.SetImage(img);
  sprite.SetX(global.cx - img.GetWidth() / 2);
  sprite.SetY(global.cy - img.GetHeight() / 2);
}

# слои знака: картинка 490 px (знак внутри около 476 px), ореолы 590 px
global.imgw = global.D * 490 / 476;
global.haloW = global.D * 590 / 476;
global.white_img = load_scaled("white.png", global.imgw);
global.light_img = load_scaled("lightblue.png", global.imgw);
global.arcs_img = load_scaled("arcs.png", global.imgw);
global.blades_img = load_scaled("blades.png", global.imgw);
global.halo_w_img = load_scaled("halo-white.png", global.haloW);
global.halo_b_img = load_scaled("halo-blue.png", global.haloW);
global.glow_img = load_scaled("glow.png", global.D * 2.4);
global.flash_img = load_scaled("flash.png", global.D * 3.0);
global.word_img = load_scaled("wordmark.png", global.D * 0.95);

# кадры вихря (прежний, с полосками света): 30 штук за 1,2 с, между соседними плавный переход
global.fx_n = 30;
global.fx_dur = 1.2;
global.fx_size = Math.Int(global.D * 2.4);
global.fn = 0;
while (global.fn < global.fx_n) {
  global.fx_src[global.fn] = Image("fx-" + global.fn + ".png");
  global.fn = global.fn + 1;
}
global.fx_i = -1;

global.glow = Sprite();    global.glow.SetZ(1);    global.glow.SetOpacity(0);
place(global.glow, global.glow_img);
global.fxa = Sprite();     global.fxa.SetZ(2);     global.fxa.SetOpacity(0);
global.fxb = Sprite();     global.fxb.SetZ(2);     global.fxb.SetOpacity(0);
global.halo_b = Sprite();  global.halo_b.SetZ(3);  global.halo_b.SetOpacity(0);
place(global.halo_b, global.halo_b_img);
global.halo_w = Sprite();  global.halo_w.SetZ(4);  global.halo_w.SetOpacity(0);
place(global.halo_w, global.halo_w_img);
global.ghost2 = Sprite();  global.ghost2.SetZ(5);  global.ghost2.SetOpacity(0);
global.ghost1 = Sprite();  global.ghost1.SetZ(6);  global.ghost1.SetOpacity(0);
global.arcs = Sprite();    global.arcs.SetZ(7);    global.arcs.SetOpacity(0);
global.light = Sprite();   global.light.SetZ(8);   global.light.SetOpacity(0);
global.white = Sprite();   global.white.SetZ(9);   global.white.SetOpacity(0);
global.flash = Sprite();   global.flash.SetZ(11);  global.flash.SetOpacity(0);
place(global.flash, global.flash_img);

global.word = Sprite(global.word_img);
global.word.SetZ(10);
global.word.SetOpacity(0);
global.word.SetX(global.cx - global.word_img.GetWidth() / 2);
global.word.SetY(global.cy + global.D * 0.5 + global.D * 0.12);

global.counter = 0;
global.landed = 0;

fun smooth(x) {
  if (x < 0) x = 0;
  if (x > 1) x = 1;
  return x * x * (3 - 2 * x);
}

# более мягкая кривая (старт и остановка без рывков)
fun smoother(x) {
  if (x < 0) x = 0;
  if (x > 1) x = 1;
  return x * x * x * (x * (x * 6 - 15) + 10);
}

# угол оборота: от 0 до 2*pi, дальше стоим на месте
fun spin_angle(t) {
  return global.PI2 * smoother((t - global.T0) / (global.T1 - global.T0));
}

# угловая скорость, рад/с
fun spin_speed(t) {
  local.s = 0;
  if (t > global.T0 && t < global.T1) {
    local.u = (t - global.T0) / (global.T1 - global.T0);
    s = global.PI2 * 30 * u * u * (1 - u) * (1 - u) / (global.T1 - global.T0);
  }
  return s;
}

fun refresh() {
  global.counter = global.counter + 1;
  local.t = global.counter / 50;
  local.fade = smooth(t / 0.6);

  # --- один оборот: лезвия по часовой, дуги против, потом стоп ---
  if (t < global.T1) {
    local.th = spin_angle(t);
    local.om = spin_speed(t);
    local.wimg = global.white_img.Rotate(0 - th);
    place(global.white, wimg);
    local.limg = global.light_img.Rotate(0 - th);
    place(global.light, limg);
    local.aimg = global.arcs_img.Rotate(th);
    place(global.arcs, aimg);
    if (om > 2) {
      local.g1 = global.blades_img.Rotate(0 - (th - om * 0.010));
      place(global.ghost1, g1);
      global.ghost1.SetOpacity(0.30 * fade);
      local.g2 = global.blades_img.Rotate(0 - (th - om * 0.022));
      place(global.ghost2, g2);
      global.ghost2.SetOpacity(0.15 * fade);
    } else {
      global.ghost1.SetOpacity(0);
      global.ghost2.SetOpacity(0);
    }
  } else if (global.landed == 0) {
    global.landed = 1;
    place(global.white, global.white_img);
    place(global.light, global.light_img);
    place(global.arcs, global.arcs_img);
    global.ghost1.SetOpacity(0);
    global.ghost2.SetOpacity(0);
  }

  # --- свечение: белые ярко / синие тускло, потом наоборот и так по кругу ---
  local.wop = 1;
  local.bop = 1;
  local.hw = 0;
  local.hb = 0;
  if (t > global.TI - 0.2) {
    local.k = smooth((t - (global.TI - 0.2)) / 0.6);
    local.s = (t - global.TI) / global.P;
    if (s < 0) s = 0;
    s = s - Math.Int(s);
    local.w = 0.5 + 0.5 * Math.Cos(global.PI2 * s);        # 1: белые, 0: синие
    local.wt = 0.15 + 0.85 * w;
    local.bt = 0.15 + 0.85 * (1 - w);
    wop = 1 - k * (1 - wt);
    bop = 1 - k * (1 - bt);
    hw = k * w * 0.9;
    hb = k * (1 - w) * 0.9;
  }
  global.white.SetOpacity(wop * fade);
  global.light.SetOpacity(bop * fade);
  global.arcs.SetOpacity(bop * fade);
  global.halo_w.SetOpacity(hw * fade);
  global.halo_b.SetOpacity(hb * fade);

  # --- общее свечение растёт при обороте и держится ровным после эффекта ---
  local.gl = 0.08 + 0.22 * smooth(t / global.T1);
  if (t > global.T1) {
    local.f = 1 - smooth((t - global.T1) / 1.0);
    gl = 0.22 + 0.45 * f;
  }
  global.glow.SetOpacity(gl * fade);

  # --- мягкая вспышка: пик в момент остановки ---
  local.d = t - global.T1;
  local.fl = 0;
  if (d > -0.18 && d < 0.8) {
    if (d < 0.04) {
      fl = smooth((d + 0.18) / 0.22);
    } else {
      fl = 1 - smooth((d - 0.04) / 0.76);
    }
  }
  global.flash.SetOpacity(fl * 0.40 * fade);

  # --- вихрь; соседние кадры плавно перетекают ---
  local.ft = (t - global.TB) / global.fx_dur * (global.fx_n - 1);
  if (ft >= 0 && ft < global.fx_n - 1) {
    local.i = Math.Int(ft);
    local.fr = ft - i;
    if (i != global.fx_i) {
      if (global.fx_i >= 0 && i == global.fx_i + 1) {
        global.fx_cur = global.fx_nxt;
      } else {
        global.fx_cur = global.fx_src[i].Scale(global.fx_size, global.fx_size);
      }
      global.fx_nxt = global.fx_src[i + 1].Scale(global.fx_size, global.fx_size);
      global.fx_i = i;
      place(global.fxa, global.fx_cur);
      place(global.fxb, global.fx_nxt);
    }
    global.fxa.SetOpacity(1 - fr);
    global.fxb.SetOpacity(fr);
  } else {
    global.fxa.SetOpacity(0);
    global.fxb.SetOpacity(0);
  }

  # --- надпись ---
  global.word.SetOpacity(smooth((t - global.T1 - 0.2) / 0.7));
}

Plymouth.SetRefreshFunction(refresh);

# запрос пароля (шифрование диска)
global.pw = Sprite();
global.pw.SetZ(100);
global.pw.SetOpacity(0);

fun display_password_callback(prompt, bullets) {
  local.s = prompt + " ";
  local.i = 0;
  while (i < bullets) {
    s = s + "*";
    i = i + 1;
  }
  local.img = Image.Text(s, 1, 1, 1);
  global.pw.SetImage(img);
  global.pw.SetX(global.cx - img.GetWidth() / 2);
  global.pw.SetY(global.sh * 0.88);
  global.pw.SetOpacity(1);
}

fun display_normal_callback() {
  global.pw.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
